# .env keys for email_samp, read through env_samp with email_setup_env().
# Copy the ones you need into the server's .env - the file env_samp already
# reads for the rest of your settings - and keep that file out of git.
#
# Same keys as smtp.ini, under the smtp. prefix. Only host is required
# (or a single smtp.url).

smtp.host      = smtp.gmail.com
smtp.user      = bot@gmail.com
smtp.password  = "abcd efgh ijkl mnop"
smtp.from_name = Los Santos RP

# Optional
# smtp.port        = 587
# smtp.encryption  = starttls        # none | starttls | tls
# smtp.from        = noreply@example.com
# smtp.rate_limit  = 60              # mails per minute, 0 = unlimited
# smtp.queue_limit = 1000
# smtp.retries     = 2
# smtp.charset     = windows-1252   # windows-1251 (Cyrillic) | utf-8
# smtp.dry_run     = 0              # 1 = write to logs/dry-run/, send nothing
# smtp.allow_plaintext_auth = 0     # only for a trusted network; see the README

# Or everything in one line instead of the keys above:
# smtp.url = smtps://bot%40gmail.com:abcdefghijklmnop@smtp.gmail.com

# A second account: another prefix, opened with email_setup_env("smtp.staff").
# smtp.staff.host = smtp.example.com
# smtp.staff.user = alerts@example.com
# smtp.staff.password = secret

# Provider notes
#   Gmail     smtp.gmail.com - needs an APP PASSWORD, not the account one.
#             The quotes keep the spaces Google shows it with.
#   SendGrid  smtp.sendgrid.net - the user is the literal word "apikey".
#   Mailgun   smtp.mailgun.org
#   SES       email-smtp.<region>.amazonaws.com - SMTP credentials from the
#             SES console, not your AWS keys.
